--- !u!102 &4888
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 143}
  m_Text: "Splash and it hears you.\nMove slowly in the water.\nDry on a platform is safe.\nThrow pebbles to distract it.\nEvery level's start is a checkpoint."
  m_OffsetZ: 0
  m_CharacterSize: 0.0109375
  m_LineSpacing: 1
