--- !u!102 &4883
TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 57}
  m_Text: "Narrow ledges by the wall,\nor long jumps on the wide pads."
  m_OffsetZ: 0
  m_CharacterSize: 0.01015625
  m_LineSpacing: 1
  m_Anchor: 4
  m_Alignment: 1
  m_TabSize: 4
  m_FontSize: 64
